{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Argus Helm values",
  "type": "object",
  "required": [
    "image",
    "replicaCount",
    "postgresql",
    "externalDatabase",
    "secrets",
    "config"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "database": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "username": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "password": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]*$",
          "description": "URL-safe characters only (it is embedded in the database URL)"
        }
      }
    },
    "migrations": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "bootstrapAdminKey": {
          "type": "string",
          "anyOf": [
            {
              "maxLength": 0
            },
            {
              "minLength": 32
            }
          ],
          "description": "Empty (generated) or at least 32 characters"
        },
        "encryptionKey": {
          "type": "string",
          "anyOf": [
            {
              "maxLength": 0
            },
            {
              "minLength": 32
            }
          ]
        },
        "smtpPassword": {
          "type": "string"
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "maxConcurrentScans": {
          "type": "integer",
          "minimum": 1
        },
        "scansPerMinute": {
          "type": "integer",
          "minimum": 1
        },
        "monitorsEnabled": {
          "type": "boolean"
        },
        "scanStaleSeconds": {
          "type": "number",
          "minimum": 10
        },
        "allowPrivateTargets": {
          "type": "boolean"
        },
        "corsOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "logLevel": {
          "enum": [
            "critical",
            "error",
            "warning",
            "info",
            "debug",
            "trace"
          ]
        },
        "extraEnv": {
          "type": "object",
          "propertyNames": {
            "pattern": "^ARGUS_[A-Z0-9_]+$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "logFormat": {
          "enum": [
            "json",
            "text"
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer"
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "databaseCIDRs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockedEgressCIDRs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "internalEgress": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "cidr"
            ],
            "properties": {
              "cidr": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 30
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "podAnnotations": {
          "type": "boolean"
        },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+[smh]$"
            },
            "labels": {
              "type": "object"
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            }
          }
        },
        "grafanaDashboard": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            },
            "folder": {
              "type": "string"
            }
          }
        }
      }
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^(|https?://[^/]+.*)$"
    },
    "sso": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "issuer": {
          "type": "string",
          "pattern": "^(|https://.+|http://(localhost|127\\.0\\.0\\.1)(:\\d+)?(/.*)?)$"
        },
        "clientId": {
          "type": "string"
        },
        "displayName": {
          "type": "string",
          "maxLength": 40
        },
        "scopes": {
          "type": "string",
          "pattern": "(^|\\s)openid(\\s|$)"
        },
        "allowedDomains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requireVerifiedEmail": {
          "type": "boolean"
        },
        "roleClaim": {
          "type": "string",
          "minLength": 1
        },
        "adminGroups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "analystGroups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "viewerGroups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaultRole": {
          "enum": [
            "viewer",
            "analyst",
            "none"
          ]
        },
        "adminEmails": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sessionTtlHours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 720
        },
        "defaultWorkspace": {
          "type": "string",
          "maxLength": 64
        },
        "workspaceGroups": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          }
        }
      }
    },
    "notifications": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "smtp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "security": {
              "enum": [
                "starttls",
                "tls",
                "none"
              ]
            },
            "username": {
              "type": "string"
            },
            "from": {
              "type": "string"
            }
          }
        },
        "scheduledReports": {
          "type": "boolean"
        }
      }
    }
  }
}
