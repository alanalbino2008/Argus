# Copy to .env (never commit it) and replace with real secrets.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
ARGUS_BOOTSTRAP_ADMIN_KEY=argus_change-me-to-at-least-32-random-characters
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password
# Encrypts notification webhook URLs and signing secrets (>= 32 random characters). Keep a copy.
ARGUS_ENCRYPTION_KEY=change-me-to-at-least-32-random-characters-too
# Optional: email notifications
# ARGUS_SMTP_HOST=smtp.office365.com
# ARGUS_SMTP_USERNAME=argus@company.com
# ARGUS_SMTP_PASSWORD=
# ARGUS_SMTP_FROM=argus@company.com
